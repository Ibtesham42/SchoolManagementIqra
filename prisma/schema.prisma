// Phase 1 schema: identity, RBAC, settings, sessions, sequences, files, audit,
// notifications, rate limiting and free-tier usage tracking.
// Phase 2a: file ownership/purpose, regional settings, logo FK, generated-document registry.
// Phase 2: classes (master data) and session-scoped sections (migration 20261110000000).
// Phase 3A: HR core — departments, designations, employees, teacher profiles, employee documents, service
// history; User.employeeId becomes an FK (migration 20261112000000, ADR-036).
// Domain models (students, fees, …) are added in later phases — see docs/DATABASE_SCHEMA.md.
// Connection URLs live in prisma.config.ts (Prisma 7), never here.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // partialIndexes: lets the schema express Section's partial unique index (one class-teacher section
  // per teacher per session) so `migrate diff` / drift checks see it instead of dropping raw SQL (ADR-034).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & access ─────────────────────────────

enum PermissionScope {
  ALL
  ASSIGNED
  SELF
  CHILDREN
}

model User {
  id                 String    @id @default(cuid(2))
  username           String    @unique // stored lowercase
  email              String?   @unique // stored lowercase by the service layer; NULLs allowed
  displayName        String    @map("display_name")
  passwordHash       String    @map("password_hash")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  // Optional links to person records. employeeId → Employee (FK since Phase 3A, ADR-036: one account per
  // employee, optional, linking audited); studentId / guardianId become FKs in Phase 6.
  employeeId         String?   @unique @map("employee_id")
  studentId          String?   @unique @map("student_id")
  guardianId         String?   @unique @map("guardian_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  roles                   UserRole[]
  sessions                Session[]
  resetTokens             PasswordResetToken[]
  notifications           Notification[]
  uploadedFiles           StoredFile[]
  generatedDocuments      GeneratedDocument[]    @relation("DocumentGeneratedBy")
  revokedDocuments        GeneratedDocument[]    @relation("DocumentRevokedBy")
  /// Sections this user is class teacher of (interim User reference until Phase 3 Employee — ADR-034).
  classTeacherOf          Section[]              @relation("SectionClassTeacher")
  // Phase 2b admissions & students (actor references; SET NULL on the child side).
  applicationsCreated     AdmissionApplication[] @relation("ApplicationCreatedBy")
  applicationsDecided     AdmissionApplication[] @relation("ApplicationDecidedBy")
  documentsUploaded       StudentDocument[]      @relation("StudentDocumentUploadedBy")
  documentsVerified       StudentDocument[]      @relation("StudentDocumentVerifiedBy")
  rollBatchesGenerated    RollNumberBatch[]      @relation("RollBatchGeneratedBy")
  rollBatchesFinalized    RollNumberBatch[]      @relation("RollBatchFinalizedBy")
  studentStatusChanges    StudentStatusChange[]  @relation("StudentStatusChangedBy")
  // Phase 3A HR (ADR-036). The FK for the optional employee link lives on this side (user.employee_id).
  employee                Employee?              @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  employeesCreated        Employee[]             @relation("EmployeeCreatedBy")
  employeeDocsUploaded    EmployeeDocument[]     @relation("EmployeeDocumentUploadedBy")
  employeeDocsVerified    EmployeeDocument[]     @relation("EmployeeDocumentVerifiedBy")
  serviceEventsActed      EmployeeServiceEvent[] @relation("EmployeeServiceEventActedBy")
  // Phase 3B attendance & leave (actor references; SET NULL).
  leaveRequested          LeaveRequest[]         @relation("LeaveRequestedBy")
  leaveDecided            LeaveRequest[]         @relation("LeaveDecidedBy")
  attendanceMarked        EmployeeAttendance[]   @relation("AttendanceMarkedBy")
  holidaysCreated         Holiday[]              @relation("HolidayCreatedBy")
  periodLocks             AttendancePeriodLock[] @relation("AttendancePeriodLockedBy")
  salariesProposed        EmployeeSalary[]       @relation("SalaryProposedBy")
  salariesDecided         EmployeeSalary[]       @relation("SalaryDecidedBy")
  payrollsPrepared        PayrollRun[]           @relation("PayrollPreparedBy")
  payrollsApproved        PayrollRun[]           @relation("PayrollApprovedBy")
  payrollAdjustments      PayrollAdjustment[]    @relation("PayrollAdjustmentCreatedBy")
  salaryPayments          SalaryPayment[]        @relation("SalaryPaidBy")
  studentAttendanceMarked StudentAttendance[]    @relation("StudentAttendanceMarkedBy")
  examinationsPublished   Examination[]          @relation("ExaminationPublishedBy")
  marksSheetsSubmitted    MarksSheet[]           @relation("MarksSheetSubmittedBy")
  marksSheetsApproved     MarksSheet[]           @relation("MarksSheetApprovedBy")
  marksEntered            ExaminationMarks[]     @relation("MarksEnteredBy")

  // Phase 4C
  promotionsProposed     PromotionDecision[] @relation("PromotionProposedBy")
  promotionsConfirmed    PromotionDecision[] @relation("PromotionConfirmedBy")
  homeworkPosted         Homework[]          @relation("HomeworkPostedBy")
  // Phase 5A fees (actor references, SetNull)
  feeConcessionsProposed StudentConcession[] @relation("ConcessionProposedBy")
  feeConcessionsDecided  StudentConcession[] @relation("ConcessionDecidedBy")
  feeChargesCreated      StudentFeeCharge[]  @relation("FeeChargeCreatedBy")
  feeInvoicesIssued      FeeInvoice[]        @relation("FeeInvoiceIssuedBy")
  feeInvoicesCancelled   FeeInvoice[]        @relation("FeeInvoiceCancelledBy")
  feePaymentsCollected   FeePayment[]        @relation("FeePaymentCollectedBy")
  feePaymentsCancelled   FeePayment[]        @relation("FeePaymentCancelledBy")

  @@index([isActive])
  @@map("user")
}

model Session {
  id         String   @id @default(cuid(2))
  tokenHash  String   @unique @map("token_hash") // SHA-256 of the cookie token; raw token never stored
  userId     String   @map("user_id")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent") @db.VarChar(400)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(cuid(2))
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

model Role {
  id          String   @id @default(cuid(2))
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id          String @id @default(cuid(2))
  key         String @unique
  module      String
  description String

  roles RolePermission[]

  @@index([module])
  @@map("permission")
}

model RolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  scope        PermissionScope @default(ALL)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// ───────────────────────────── Settings & core ─────────────────────────────

/// Singleton row (id = "default"). School-specific facts live here, never in code.
/// No secrets: API keys and passwords are environment variables only.
model SchoolSetting {
  id                         String                @id @default("default")
  name                       String
  shortCode                  String                @map("short_code") @db.VarChar(10)
  affiliationNo              String?               @map("affiliation_no")
  board                      String?
  address                    Json?
  phones                     String[]
  email                      String?
  website                    String?
  logoFileId                 String?               @map("logo_file_id")
  timezone                   String                @default("Asia/Kolkata")
  /// BCP 47 locale for number/date formatting.
  locale                     String                @default("en-IN") @db.VarChar(16)
  /// ISO 4217 code. Display only — money is always Decimal(12,2) in this currency.
  currency                   String                @default("INR") @db.VarChar(3)
  /// One of the formats allowed by settings.schemas (DATE_FORMATS).
  dateFormat                 String                @default("DD/MM/YYYY") @map("date_format") @db.VarChar(16)
  timings                    Json?
  branding                   Json?
  idFormats                  Json?                 @map("id_formats")
  rollNumberRules            Json?                 @map("roll_number_rules")
  /// Phase 3B (L3): staff weekly off, e.g. { "days": [0], "saturdays": [2, 4] } (0 = Sunday; nth Saturdays).
  weeklyOff                  Json?                 @map("weekly_off")
  /// Phase 3C (P3): proration basis. No default: payroll refuses to prepare until the school chooses.
  payrollDayBasis            PayrollDayBasis?      @map("payroll_day_basis")
  /// Phase 4A (AC6): student weekly off, same shape as weeklyOff; often different from staff. Not set = none.
  studentWeeklyOff           Json?                 @map("student_weekly_off")
  /// Phase 4B (AC14): show the rank in class on report cards. Off by default.
  showRank                   Boolean               @default(false) @map("show_rank")
  features                   Json? // toggles for optional external services (email, AI, payments)
  /// Capacity offered for a new section when neither the form nor its class gives one. A default,
  /// not a limit: every section stores its own capacity. CHECK 1–200 (migration 20261110000000).
  defaultSectionCapacity     Int                   @default(40) @map("default_section_capacity") @db.SmallInt
  /// Documents an admission should have (D10): missing ones show a warning, never block approval.
  /// Configurable in Settings; default photo + birth certificate (migration 20261111000000).
  requiredAdmissionDocuments StudentDocumentType[] @default([PHOTO, BIRTH_CERTIFICATE]) @map("required_admission_documents")
  /// The single current academic session (a reference here guarantees there is at most one).
  currentAcademicSessionId   String?               @unique @map("current_academic_session_id")
  createdAt                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  currentAcademicSession AcademicSession? @relation(fields: [currentAcademicSessionId], references: [id], onDelete: Restrict)
  logoFile               StoredFile?      @relation("SchoolLogo", fields: [logoFileId], references: [id], onDelete: SetNull)

  @@map("school_setting")
}

enum AcademicSessionStatus {
  PLANNED
  ACTIVE
  CLOSED
}

model AcademicSession {
  id        String                @id @default(cuid(2))
  name      String                @unique // e.g. "2026-27"
  startDate DateTime              @map("start_date") @db.Date
  endDate   DateTime              @map("end_date") @db.Date
  status    AcademicSessionStatus @default(PLANNED)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  currentFor         SchoolSetting?
  sections           Section[]
  applications       AdmissionApplication[]
  enrollments        StudentEnrollment[]
  admittedStudents   Student[]              @relation("StudentAdmittedSession")
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  classSubjects      ClassSubject[]
  studentSubjects    StudentSubject[]
  teacherAllocations TeacherAllocation[]
  periods            Period[]
  timetableSlots     TimetableSlot[]
  studentAttendance  StudentAttendance[]
  examinations       Examination[]
  examSubjects       ExamSubject[]
  marksSheets        MarksSheet[]
  examinationMarks   ExaminationMarks[]
  reportCards        ReportCard[]

  // Phase 4C
  promotionDecisions PromotionDecision[]
  homework           Homework[]
  academicEvents     AcademicEvent[]
  feeInstallments    FeeInstallment[]
  feeStructures      FeeStructure[]
  lateFeeRules       LateFeeRule[]

  @@map("academic_session")
}

// ───────────────────────────── Academic structure (Phase 2) ─────────────────────────────

/// Master list of classes (grades), independent of academic sessions. Never deleted — deactivate.
/// Streams are separate classes ("Class 11 Science", "Class 11 Commerce"). CHECKs in migration
/// 20261110000000: code format, name_key derived from name, level range, capacity range, version ≥ 1.
model SchoolClass {
  id                     String   @id @default(cuid(2))
  /// Stable code used by imports and reports, e.g. "C06", "C11-SCI": uppercase A–Z, 0–9 and inner
  /// hyphens. Immutable once any section uses the class (enforced by academic service).
  code                   String   @unique @db.VarChar(10)
  name                   String   @db.VarChar(60)
  /// lower(name) with surrounding spaces trimmed and inner runs collapsed — case-insensitive
  /// uniqueness without an expression index (CHECK ties it to name).
  nameKey                String   @unique @map("name_key") @db.VarChar(60)
  /// Ordering / promotion level: -3 … 0 for pre-primary (Pre-nursery … UKG), 1–12. Not unique:
  /// stream classes share a level.
  numericLevel           Int      @map("numeric_level") @db.SmallInt
  displayOrder           Int      @default(0) @map("display_order")
  /// Optional per-class default for new sections; null → SchoolSetting.defaultSectionCapacity.
  defaultSectionCapacity Int?     @map("default_section_capacity") @db.SmallInt
  isActive               Boolean  @default(true) @map("is_active")
  /// Optimistic-concurrency token: every update must match and increment it.
  version                Int      @default(1)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sections      Section[]
  applications  AdmissionApplication[]
  classSubjects ClassSubject[]

  // Phase 4C
  promotionTargets PromotionDecision[]
  feeStructures    FeeStructure[]

  @@index([isActive, displayOrder])
  @@map("school_class")
}

/// A section of a class in one academic session (e.g. 2026-27 · Class 6 · A). Editable only while the
/// session is PLANNED or ACTIVE (academic service). Hard delete only while nothing references it;
/// future StudentEnrollment / RollNumberBatch rows reference it with ON DELETE RESTRICT.
model Section {
  id                String   @id @default(cuid(2))
  academicSessionId String   @map("academic_session_id")
  classId           String   @map("class_id")
  /// Display name, e.g. "A", "Rose": letters, digits and single inner spaces.
  name              String   @db.VarChar(20)
  /// lower(name), trimmed/collapsed (CHECK) — unique per session and class.
  nameKey           String   @map("name_key") @db.VarChar(20)
  /// "<class code>-<NAME without spaces>", e.g. "C06-A"; derived by the service, unique per session.
  code              String   @db.VarChar(32)
  /// Maximum active enrollments (CHECK 1–200). Checked under a row lock when enrolling (Phase 2).
  capacity          Int      @db.SmallInt
  /// Interim class-teacher reference (ADR-034): an active user holding the TEACHER or CLASS_TEACHER
  /// role (academic service). Phase 3 reaches the Employee through User.employeeId.
  classTeacherId    String?  @map("class_teacher_id")
  isActive          Boolean  @default(true) @map("is_active")
  /// Optimistic-concurrency token: every update must match and increment it.
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession    AcademicSession        @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  class              SchoolClass            @relation(fields: [classId], references: [id], onDelete: Restrict)
  classTeacher       User?                  @relation("SectionClassTeacher", fields: [classTeacherId], references: [id], onDelete: Restrict)
  applications       AdmissionApplication[]
  enrollments        StudentEnrollment[]
  rollNumberBatch    RollNumberBatch?
  teacherAllocations TeacherAllocation[]
  timetableSlots     TimetableSlot[]
  marksSheets        MarksSheet[]

  // Phase 4C
  homework Homework[]

  @@unique([academicSessionId, classId, nameKey])
  @@unique([academicSessionId, code])
  /// Target of StudentEnrollment's composite FK (section belongs to the enrollment's session).
  @@unique([id, academicSessionId], map: "section_id_academic_session_id_key")
  /// One section per class teacher per session (partial: rows without a class teacher are ignored).
  @@unique([academicSessionId, classTeacherId], map: "section_session_class_teacher_key", where: raw("class_teacher_id IS NOT NULL"))
  @@index([classId])
  @@map("section")
}

/// Row-locked counters for human-facing serial numbers (see student-id-generation skill).
model SequenceCounter {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sequence_counter")
}

enum FileVisibility {
  PUBLIC // CMS media → Cloudinary (or other public CDN)
  PRIVATE // confidential documents → private storage, encrypted at rest by the app
}

model StoredFile {
  id           String         @id @default(cuid(2))
  visibility   FileVisibility
  provider     String // "local" | "s3" | "cloudinary"
  storageKey   String         @unique @map("storage_key")
  originalName String         @map("original_name") @db.VarChar(255)
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  sha256       String
  encrypted    Boolean        @default(false)
  keyVersion   Int?           @map("key_version")
  uploadedById String?        @map("uploaded_by_id")
  /// Upload purpose (lib/storage/upload-rules UPLOAD_RULES key) — decides who may read the file.
  /// "unclassified" only for rows that existed before purposes: owner ("LegacyFile", <own id>),
  /// readable by Super Admin only, whatever their visibility.
  purpose      String         @db.VarChar(40)
  /// Owning record (polymorphic, no FK), e.g. ("SchoolSetting","default"), ("GeneratedDocument", id).
  /// CHECKs in migration 20261109000000: PRIVATE ⇒ owner set and encrypted with a key version;
  /// owner columns set together.
  ownerType    String?        @map("owner_type") @db.VarChar(40)
  ownerId      String?        @map("owner_id") @db.VarChar(64)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)
  /// S-15 (owner decision 2026-11-18): when the purge job deleted the blob of a retired file (deletedAt + 30-day
  /// grace). The metadata row is kept (no content) so audit trails stay resolvable. CHECK: purged ⇒ retired.
  purgedAt     DateTime?      @map("purged_at") @db.Timestamptz(3)

  uploadedBy        User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  logoFor           SchoolSetting[]    @relation("SchoolLogo")
  generatedDocument GeneratedDocument? @relation("GeneratedDocumentFile")
  studentDocument   StudentDocument?   @relation("StudentDocumentFile")
  employeeDocument  EmployeeDocument?  @relation("EmployeeDocumentFile")

  @@index([sha256])
  @@index([visibility])
  @@index([ownerType, ownerId])
  @@map("stored_file")
}

enum GeneratedDocumentType {
  ID_CARD
  CERTIFICATE
  RECEIPT
  REPORT_CARD
  SALARY_SLIP
  OTHER
}

/// Registry of issued PDFs (ID cards, certificates, receipts…) for public verification.
/// The verification code is shown on the document only; the database keeps an HMAC of it.
model GeneratedDocument {
  id String @id @default(cuid(2))

  type                   GeneratedDocumentType
  /// HMAC-SHA256 of the normalized code with DOCUMENT_VERIFICATION_KEY (version below), hex.
  /// The raw code is never stored.
  verificationCodeHash   String                @unique @map("verification_code_hash") @db.Char(64)
  /// Which DOCUMENT_VERIFICATION_KEY produced the hash; older keys stay configured as
  /// DOCUMENT_VERIFICATION_KEY_V<n> so documents issued before a rotation still verify.
  verificationKeyVersion Int                   @map("verification_key_version") @db.SmallInt
  /// The record the document is about (polymorphic, no FK), e.g. ("Student", id). Never shown publicly.
  subjectType            String                @map("subject_type") @db.VarChar(40)
  subjectId              String                @map("subject_id") @db.VarChar(64)
  /// The PDF (always a PRIVATE StoredFile; enforced by documents.service).
  fileId                 String?               @unique @map("file_id")
  generatedById          String?               @map("generated_by_id")
  generatedAt            DateTime              @default(now()) @map("generated_at") @db.Timestamptz(3)
  /// Revocation: non-null = revoked; revoked documents fail verification.
  revokedAt              DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedById            String?               @map("revoked_by_id")
  revocationReason       String?               @map("revocation_reason") @db.VarChar(500)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  file        StoredFile? @relation("GeneratedDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)
  generatedBy User?       @relation("DocumentGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  revokedBy   User?       @relation("DocumentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  reportCard  ReportCard?

  @@index([subjectType, subjectId])
  @@index([type, generatedAt])
  @@map("generated_document")
}

// ───────────────────────────── Audit & notifications ─────────────────────────────

/// Append-only. Polymorphic entity reference (no FK) so entries survive deletes.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id")
  actorLabel String?  @map("actor_label")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipHash     String?  @map("ip_hash")
  requestId  String?  @map("request_id")
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId, at])
  @@index([action, at])
  @@map("audit_log")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model Notification {
  id        String              @id @default(cuid(2))
  userId    String              @map("user_id")
  type      String
  title     String
  body      String
  link      String?
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notification")
}

// ───────────────────────────── Rate limiting & free-tier usage ─────────────────────────────

/// Fixed-window counters for the Postgres rate limiter (works across serverless instances).
model RateLimitBucket {
  key       String   @id // e.g. "login:ip:<hash>:<window>"
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_bucket")
}

/// Daily counters of metered external usage (emails, AI calls, uploads) so the app can
/// warn before and hard-stop at free-tier limits. See docs/FREE_TIER.md.
model UsageCounter {
  metric String // e.g. "email.sent", "ai.requests", "cloudinary.uploads"
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([metric, day])
  @@map("usage_counter")
}

// ───────────────────────────── Admissions & students (Phase 2b — DRAFT, migration 20261111000000) ─────────────────────────────
// Design: docs/PHASE_2B_STUDENTS_DESIGN.md (ADR-035). An application holds applicant data until it is
// APPROVED; approval creates the permanent Student, Guardians, the session Enrollment and both IDs in
// one transaction. Nothing here is applied until the owner approves the migration.

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  DETAINED
  LEFT
}

enum StudentDocumentType {
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  PREVIOUS_MARKSHEET
  PHOTO
  OTHER
}

enum RollNumberBatchStatus {
  DRAFT
  FINALIZED
}

enum RollNumberSource {
  GENERATED
  APPENDED
  CORRECTED
}

/// An admission application (one child, one academic session). Hard-deleted only while DRAFT.
/// CHECKs (migration): non-DRAFT ⇒ applicationNo; APPROVED ⇒ studentId + sectionId + decidedAt +
/// admissionDate; REJECTED ⇒ rejectionReason + decidedAt; dob ≥ 1990-01-01; version ≥ 1.
model AdmissionApplication {
  id                 String          @id @default(cuid(2))
  /// "APP-2026-27-0001" — assigned on first SUBMIT (lib/sequence), so abandoned drafts leave no gaps.
  applicationNo      String?         @unique @map("application_no") @db.VarChar(32)
  academicSessionId  String          @map("academic_session_id")
  /// Class applied for. The section is chosen by the reviewer (required before approval).
  classId            String          @map("class_id")
  sectionId          String?         @map("section_id")
  status             AdmissionStatus @default(DRAFT)
  firstName          String          @map("first_name") @db.VarChar(60)
  middleName         String?         @map("middle_name") @db.VarChar(60)
  lastName           String?         @map("last_name") @db.VarChar(60)
  /// Display name as entered ("Ananya Das").
  fullName           String          @map("full_name") @db.VarChar(185)
  /// NFC, trimmed, single spaces, lower case — duplicate detection and roll-number ordering.
  fullNameNormalized String          @map("full_name_normalized") @db.VarChar(185)
  dob                DateTime        @db.Date
  gender             Gender
  phone              String?         @db.VarChar(10)
  email              String?         @db.VarChar(254)
  /// { line1, line2?, city, district?, state, pinCode, country } (same shape as the school address).
  address            Json?
  /// { name, board?, lastClass?, yearLeft?, tcNumber? }
  previousSchool     Json?           @map("previous_school")
  /// Date of admission recorded on approval (school-local date; defaults to "today" in the school zone).
  admissionDate      DateTime?       @map("admission_date") @db.Date
  /// Possible duplicates found at submit/approval: [{ kind: "student"|"application", id }] (ids only).
  duplicateMatches   Json?           @map("duplicate_matches")
  /// Mandatory when approving despite duplicate matches (admission.approve).
  duplicateOverride  String?         @map("duplicate_override") @db.VarChar(500)
  rejectionReason    String?         @map("rejection_reason") @db.VarChar(500)
  createdById        String?         @map("created_by_id")
  submittedAt        DateTime?       @map("submitted_at") @db.Timestamptz(3)
  reviewStartedAt    DateTime?       @map("review_started_at") @db.Timestamptz(3)
  decidedAt          DateTime?       @map("decided_at") @db.Timestamptz(3)
  decidedById        String?         @map("decided_by_id")
  /// Set by approval; unique, so one application can never register two students.
  studentId          String?         @unique @map("student_id")
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession     @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  class           SchoolClass         @relation(fields: [classId], references: [id], onDelete: Restrict)
  section         Section?            @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  student         Student?            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation("ApplicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy       User?               @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  guardians       AdmissionGuardian[]
  documents       StudentDocument[]

  @@index([academicSessionId, status])
  @@index([fullNameNormalized, dob])
  @@index([status, updatedAt])
  @@map("admission_application")
}

/// Parent/guardian as entered on an application. Copied into Guardian/StudentGuardian on approval,
/// or linked to an existing Guardian the reviewer explicitly picked (siblings) — never auto-matched.
model AdmissionGuardian {
  id                 String           @id @default(cuid(2))
  applicationId      String           @map("application_id")
  relation           GuardianRelation
  name               String           @db.VarChar(120)
  /// 10 digits (the schema strips +91 / 0 / spaces / hyphens).
  phone              String           @db.VarChar(10)
  altPhone           String?          @map("alt_phone") @db.VarChar(10)
  email              String?          @db.VarChar(254)
  occupation         String?          @db.VarChar(80)
  isPrimary          Boolean          @default(false) @map("is_primary")
  isEmergencyContact Boolean          @default(false) @map("is_emergency_contact")
  /// Existing Guardian chosen by the reviewer (same phone = possible sibling); null → create new.
  linkGuardianId     String?          @map("link_guardian_id")
  sortOrder          Int              @default(0) @map("sort_order") @db.SmallInt
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  application  AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  linkGuardian Guardian?            @relation(fields: [linkGuardianId], references: [id], onDelete: Restrict)

  /// One father and one mother per application (GUARDIAN/OTHER may repeat). The predicate is written in
  /// PostgreSQL's canonical form (what pg_indexes stores for the migration's `relation IN ('FATHER', 'MOTHER')`)
  /// because Prisma compares predicate text in drift checks (KI-055).
  @@unique([applicationId, relation], map: "admission_guardian_application_parent_key", where: raw("relation = ANY (ARRAY['FATHER'::\"GuardianRelation\", 'MOTHER'::\"GuardianRelation\"])"))
  /// At most one primary contact per application.
  @@unique([applicationId], map: "admission_guardian_application_primary_key", where: raw("is_primary"))
  @@index([phone])
  @@map("admission_guardian")
}

/// Permanent student record (session-independent). studentCode and admissionNo never change.
/// Soft-deleted only (deletedAt). Aadhaar and medical data are deliberately NOT collected in this
/// phase (data minimisation — design D6).
model Student {
  id                 String        @id @default(cuid(2))
  /// Permanent student ID, e.g. "DEMO-2026-0001" (SchoolSetting.idFormats.studentId).
  studentCode        String        @unique @map("student_code") @db.VarChar(32)
  /// Admission register number, e.g. "ADM-2026-0001" (SchoolSetting.idFormats.admissionNo).
  admissionNo        String        @unique @map("admission_no") @db.VarChar(32)
  firstName          String        @map("first_name") @db.VarChar(60)
  middleName         String?       @map("middle_name") @db.VarChar(60)
  lastName           String?       @map("last_name") @db.VarChar(60)
  fullName           String        @map("full_name") @db.VarChar(185)
  fullNameNormalized String        @map("full_name_normalized") @db.VarChar(185)
  dob                DateTime      @db.Date
  gender             Gender
  phone              String?       @db.VarChar(10)
  email              String?       @db.VarChar(254)
  address            Json?
  previousSchool     Json?         @map("previous_school")
  status             StudentStatus @default(ACTIVE)
  admissionDate      DateTime      @map("admission_date") @db.Date
  /// Session of first admission (history; the current class comes from that session's enrollment).
  admittedSessionId  String        @map("admitted_session_id")
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(3)

  admittedSession AcademicSession       @relation("StudentAdmittedSession", fields: [admittedSessionId], references: [id], onDelete: Restrict)
  application     AdmissionApplication?
  guardians       StudentGuardian[]
  enrollments     StudentEnrollment[]
  documents       StudentDocument[]
  statusChanges   StudentStatusChange[]
  feePayments     FeePayment[]

  @@index([fullNameNormalized, dob])
  @@index([status])
  @@map("student")
}

/// A parent/guardian person, shared between siblings through StudentGuardian. Soft delete only.
model Guardian {
  id         String    @id @default(cuid(2))
  name       String    @db.VarChar(120)
  phone      String    @db.VarChar(10)
  altPhone   String?   @map("alt_phone") @db.VarChar(10)
  email      String?   @db.VarChar(254)
  occupation String?   @db.VarChar(80)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  students       StudentGuardian[]
  applicantLinks AdmissionGuardian[]

  @@index([phone])
  @@map("guardian")
}

model StudentGuardian {
  studentId          String           @map("student_id")
  guardianId         String           @map("guardian_id")
  relation           GuardianRelation
  isPrimary          Boolean          @default(false) @map("is_primary")
  isEmergencyContact Boolean          @default(false) @map("is_emergency_contact")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@id([studentId, guardianId])
  /// At most one primary guardian per student.
  @@unique([studentId], map: "student_guardian_student_primary_key", where: raw("is_primary"))
  @@index([guardianId])
  @@map("student_guardian")
}

/// A document of an application and, after approval, of the student (same row; approval sets
/// studentId). Its StoredFile (PRIVATE, encrypted) is owned by this row — StoredFile.ownerType =
/// "StudentDocument", ownerId = id — so file ownership never moves. CHECK: applicationId or studentId.
model StudentDocument {
  id            String              @id @default(cuid(2))
  applicationId String?             @map("application_id")
  studentId     String?             @map("student_id")
  type          StudentDocumentType
  fileId        String              @unique @map("file_id")
  /// Optional free text, required for OTHER (e.g. "Caste certificate").
  label         String?             @db.VarChar(80)
  uploadedById  String?             @map("uploaded_by_id")
  verifiedById  String?             @map("verified_by_id")
  verifiedAt    DateTime?           @map("verified_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Replaced or removed (its StoredFile is retired in the same transaction).
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(3)

  application AdmissionApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  student     Student?              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  file        StoredFile            @relation("StudentDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy  User?                 @relation("StudentDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy  User?                 @relation("StudentDocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  /// One current photo per application and per student.
  @@unique([applicationId], map: "student_document_application_photo_key", where: raw("type = 'PHOTO' AND deleted_at IS NULL AND application_id IS NOT NULL"))
  @@unique([studentId], map: "student_document_student_photo_key", where: raw("type = 'PHOTO' AND deleted_at IS NULL AND student_id IS NOT NULL"))
  @@index([applicationId])
  @@index([studentId])
  @@map("student_document")
}

/// One per student per academic session (history is never overwritten: promotion = new row).
/// The class is the section's class. Capacity is checked under the section's row lock.
model StudentEnrollment {
  id                String           @id @default(cuid(2))
  studentId         String           @map("student_id")
  academicSessionId String           @map("academic_session_id")
  sectionId         String           @map("section_id")
  status            EnrollmentStatus @default(ACTIVE)
  enrolledOn        DateTime         @map("enrolled_on") @db.Date
  leftOn            DateTime?        @map("left_on") @db.Date
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  student         Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicSession AcademicSession     @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  /// Composite FK: the section must belong to the enrollment's own session (DB-enforced).
  section         Section             @relation(fields: [sectionId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  rollNumber      StudentRollNumber?
  subjects        StudentSubject[]
  attendance      StudentAttendance[]
  marks           ExaminationMarks[]
  reportCards     ReportCard[]

  // Phase 4C
  promotionFrom  PromotionDecision?  @relation("PromotionFrom")
  promotionTo    PromotionDecision?  @relation("PromotionTo")
  // Phase 5A fees: billed per enrollment, referenced by (studentId, academicSessionId).
  feeConcessions StudentConcession[]
  feeCharges     StudentFeeCharge[]
  feeInvoices    FeeInvoice[]

  @@unique([studentId, academicSessionId])
  /// Phase 4A: target of composite FKs (student subjects and attendance stay in the enrollment's session).
  @@unique([id, academicSessionId], map: "student_enrollment_id_academic_session_id_key")
  @@index([sectionId, status])
  @@index([academicSessionId, status])
  @@map("student_enrollment")
}

/// Roll numbers of one section (a section belongs to one session). DRAFT → FINALIZED; a finalized
/// batch is never re-sorted automatically: later admissions are APPENDED (max + 1).
model RollNumberBatch {
  id            String                @id @default(cuid(2))
  sectionId     String                @unique @map("section_id")
  status        RollNumberBatchStatus @default(DRAFT)
  version       Int                   @default(1)
  generatedById String?               @map("generated_by_id")
  generatedAt   DateTime              @default(now()) @map("generated_at") @db.Timestamptz(3)
  finalizedById String?               @map("finalized_by_id")
  finalizedAt   DateTime?             @map("finalized_at") @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  section     Section             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  generatedBy User?               @relation("RollBatchGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  finalizedBy User?               @relation("RollBatchFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  numbers     StudentRollNumber[]

  @@map("roll_number_batch")
}

model StudentRollNumber {
  id           String           @id @default(cuid(2))
  batchId      String           @map("batch_id")
  enrollmentId String           @unique @map("enrollment_id")
  rollNumber   Int              @map("roll_number") @db.SmallInt
  source       RollNumberSource @default(GENERATED)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch      RollNumberBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([batchId, rollNumber])
  @@map("student_roll_number")
}

/// ACTIVE → TRANSFERRED / GRADUATED / WITHDRAWN (and re-admission back to ACTIVE). Append-only.
model StudentStatusChange {
  id            String        @id @default(cuid(2))
  studentId     String        @map("student_id")
  fromStatus    StudentStatus @map("from_status")
  toStatus      StudentStatus @map("to_status")
  reason        String        @db.VarChar(500)
  effectiveDate DateTime      @map("effective_date") @db.Date
  actedById     String?       @map("acted_by_id")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  actedBy User?   @relation("StudentStatusChangedBy", fields: [actedById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@map("student_status_change")
}

// ───────────────────────────── Phase 3A — HR core (ADR-036; PHASE_3_PLAN.md §3a) ─────────────────────────────
// One school per installation (ADR-030): no school_id. People and history are never hard-deleted: every FK
// RESTRICT except actor references (SET NULL). CHECK constraints are hand-written in the migration.

enum StaffType {
  TEACHING
  NON_TEACHING
}

enum AppointmentType {
  PERMANENT
  PROBATION
  CONTRACT
  PART_TIME
  GUEST
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  RETIRED
}

enum EmployeeDocumentType {
  PHOTO
  RESUME
  QUALIFICATION_CERTIFICATE
  EXPERIENCE_LETTER
  APPOINTMENT_LETTER
  RELIEVING_LETTER
  OTHER
}

enum ServiceEventType {
  JOINED
  CONFIRMED
  DEPARTMENT_CHANGED
  DESIGNATION_CHANGED
  APPOINTMENT_TYPE_CHANGED
  REPORTING_CHANGED
  TRANSFERRED
  STATUS_CHANGED
  RESIGNED
  TERMINATED
  RETIRED
  REJOINED
}

/// Master data (H9): deactivated, never deleted once used. Case-insensitive unique name via nameKey.
model Department {
  id        String   @id @default(cuid(2))
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(80)
  nameKey   String   @unique @map("name_key") @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees Employee[]

  @@map("department")
}

/// Master data (H9). An employee's staffType must equal the designation's (service rule).
model Designation {
  id        String    @id @default(cuid(2))
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(80)
  nameKey   String    @unique @map("name_key") @db.VarChar(80)
  staffType StaffType @map("staff_type")
  isActive  Boolean   @default(true) @map("is_active")
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees Employee[]

  @@map("designation")
}

/// One record per staff member (teaching and non-teaching), separate from login credentials (H2).
/// employeeCode is permanent (H3). No Aadhaar/PAN/bank/medical data in Phase 3A (H5). Soft delete only.
model Employee {
  id                 String           @id @default(cuid(2))
  /// Permanent employee ID, e.g. "EMP-2026-0001" (SchoolSetting.idFormats.employeeCode; {YYYY} = joining year).
  employeeCode       String           @unique @map("employee_code") @db.VarChar(32)
  staffType          StaffType        @map("staff_type")
  appointmentType    AppointmentType  @map("appointment_type")
  employmentStatus   EmploymentStatus @default(ACTIVE) @map("employment_status")
  firstName          String           @map("first_name") @db.VarChar(60)
  middleName         String?          @map("middle_name") @db.VarChar(60)
  lastName           String?          @map("last_name") @db.VarChar(60)
  fullName           String           @map("full_name") @db.VarChar(185)
  fullNameNormalized String           @map("full_name_normalized") @db.VarChar(185)
  dob                DateTime         @db.Date
  gender             Gender
  workPhone          String?          @map("work_phone") @db.VarChar(10)
  personalPhone      String           @map("personal_phone") @db.VarChar(10)
  workEmail          String?          @map("work_email") @db.VarChar(254)
  personalEmail      String?          @map("personal_email") @db.VarChar(254)
  /// { line1, line2?, city, district?, state, pinCode, country } — personal tier (H6).
  address            Json?
  /// { name, relation, phone } — personal tier (H6).
  emergencyContact   Json?            @map("emergency_contact")
  departmentId       String           @map("department_id")
  designationId      String           @map("designation_id")
  reportsToId        String?          @map("reports_to_id")
  joiningDate        DateTime         @map("joining_date") @db.Date
  confirmationDate   DateTime?        @map("confirmation_date") @db.Date
  leavingDate        DateTime?        @map("leaving_date") @db.Date
  leavingReason      String?          @map("leaving_reason") @db.VarChar(500)
  /// Phase 3C (P8): optional PAN and bank details. AES-256-GCM via lib/crypto (*Enc) + HMAC for dedupe (*Hmac);
  /// shown masked, only with employee.sensitive.read; never logged, audited or exported in clear.
  panEnc             String?          @map("pan_enc")
  panHmac            String?          @unique @map("pan_hmac") @db.VarChar(64)
  bankAccountEnc     String?          @map("bank_account_enc")
  bankAccountHmac    String?          @map("bank_account_hmac") @db.VarChar(64)
  bankIfsc           String?          @map("bank_ifsc") @db.VarChar(11)
  bankAccountName    String?          @map("bank_account_name") @db.VarChar(120)
  version            Int              @default(1)
  createdById        String?          @map("created_by_id")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)

  department         Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation        Designation            @relation(fields: [designationId], references: [id], onDelete: Restrict)
  /// Reporting line (H10): self-reference; no self-reporting (CHECK) and no cycles (service, under locks).
  reportsTo          Employee?              @relation("EmployeeReportsTo", fields: [reportsToId], references: [id], onDelete: Restrict)
  directReports      Employee[]             @relation("EmployeeReportsTo")
  createdBy          User?                  @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Optional login account (H2): the FK lives on User.employeeId.
  user               User?                  @relation("UserEmployee")
  teacherProfile     TeacherProfile?
  documents          EmployeeDocument[]
  serviceEvents      EmployeeServiceEvent[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  attendance         EmployeeAttendance[]
  salaries           EmployeeSalary[]
  payrollSlips       PayrollSlip[]
  teacherAllocations TeacherAllocation[]
  timetableSlots     TimetableSlot[]

  @@index([fullNameNormalized])
  @@index([staffType, employmentStatus])
  @@index([departmentId])
  @@index([designationId])
  @@index([reportsToId])
  @@map("employee")
}

/// 1:1 with a TEACHING employee (service rule). Specialisations are free text until Phase 4 subjects (H14).
model TeacherProfile {
  employeeId                 String   @id @map("employee_id")
  /// [{ degree, subject?, institution?, year? }] — at most 10 (schema + CHECK).
  qualifications             Json     @default("[]")
  /// [{ name (e.g. B.Ed, CTET), year? }] — at most 10.
  professionalQualifications Json     @default("[]") @map("professional_qualifications")
  specializations            String[] @default([]) @db.VarChar(60)
  experienceYearsBefore      Int      @default(0) @map("experience_years_before") @db.SmallInt
  teacherRegistrationNo      String?  @map("teacher_registration_no") @db.VarChar(40)
  version                    Int      @default(1)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("teacher_profile")
}

/// A staff document; its StoredFile (PRIVATE, encrypted) is owned by this row (ownerType "EmployeeDocument").
model EmployeeDocument {
  id           String               @id @default(cuid(2))
  employeeId   String               @map("employee_id")
  type         EmployeeDocumentType
  fileId       String               @unique @map("file_id")
  /// Optional free text, required for OTHER.
  label        String?              @db.VarChar(80)
  uploadedById String?              @map("uploaded_by_id")
  verifiedById String?              @map("verified_by_id")
  verifiedAt   DateTime?            @map("verified_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Replaced or removed (its StoredFile is retired in the same transaction).
  deletedAt    DateTime?            @map("deleted_at") @db.Timestamptz(3)

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  file       StoredFile @relation("EmployeeDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy User?      @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy User?      @relation("EmployeeDocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  /// One current photo per employee.
  @@unique([employeeId], map: "employee_document_employee_photo_key", where: raw("type = 'PHOTO' AND deleted_at IS NULL"))
  @@index([employeeId])
  @@map("employee_document")
}

/// Append-only career history (H12): written by the service in the same transaction as the change;
/// no update/delete path. (A DB trigger is a separate S-07 decision.)
model EmployeeServiceEvent {
  id            String           @id @default(cuid(2))
  employeeId    String           @map("employee_id")
  eventType     ServiceEventType @map("event_type")
  effectiveDate DateTime         @map("effective_date") @db.Date
  /// Changed fields only (ids, codes, enum values and dates). Includes employment terms (appointment type,
  /// confirmation date) — personal tier: the history is shown only with employee.personal.read (or SELF).
  before        Json?
  after         Json?
  remarks       String?          @db.VarChar(500)
  actedById     String?          @map("acted_by_id")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  actedBy  User?    @relation("EmployeeServiceEventActedBy", fields: [actedById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveDate])
  @@map("employee_service_event")
}

// ───────────────────────────── Phase 3B — staff attendance & leave (PHASE_3B_PLAN.md, L1–L12) ─────────────────────────────
// Leave year = academic session (L1). Leave types are school-defined (L2, nothing seeded). Days are Decimal
// (half-days, L10) — never floats. Every FK RESTRICT except actor columns (SET NULL). CHECKs hand-written.

enum LeaveAppliesTo {
  ALL
  TEACHING
  NON_TEACHING
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDay {
  FIRST
  SECOND
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKLY_OFF
}

enum AttendanceSource {
  MANUAL
  IMPORT
}

enum HolidayAppliesTo {
  ALL
  STAFF
  STUDENTS
}

/// Master data (L2): school-defined; deactivated, never deleted once used. Case-insensitive unique name via nameKey.
model LeaveType {
  id              String         @id @default(cuid(2))
  code            String         @unique @db.VarChar(20)
  name            String         @db.VarChar(80)
  nameKey         String         @unique @map("name_key") @db.VarChar(80)
  isPaid          Boolean        @map("is_paid")
  /// Days allotted per academic session; null = no quota (e.g. an unpaid LOP type).
  annualQuota     Decimal?       @map("annual_quota") @db.Decimal(4, 1)
  allowHalfDay    Boolean        @default(true) @map("allow_half_day")
  /// Unused days that may move to the next session (0 = none).
  carryForwardMax Decimal        @default(0) @map("carry_forward_max") @db.Decimal(4, 1)
  appliesTo       LeaveAppliesTo @default(ALL) @map("applies_to")
  isActive        Boolean        @default(true) @map("is_active")
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_type")
}

/// One per employee × leave type × academic session (L1). `used` changes only with approvals/cancellations.
model LeaveBalance {
  id                String   @id @default(cuid(2))
  employeeId        String   @map("employee_id")
  leaveTypeId       String   @map("leave_type_id")
  academicSessionId String   @map("academic_session_id")
  allotted          Decimal  @default(0) @db.Decimal(5, 1)
  carriedForward    Decimal  @default(0) @map("carried_forward") @db.Decimal(5, 1)
  used              Decimal  @default(0) @db.Decimal(5, 1)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType       LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, academicSessionId])
  @@index([academicSessionId])
  @@map("leave_balance")
}

/// A leave application. No overlap with another PENDING/APPROVED request of the same employee — checked by the
/// service under the employee row lock (two half-days on one date may combine; see the M1 proposal).
model LeaveRequest {
  id                String             @id @default(cuid(2))
  employeeId        String             @map("employee_id")
  leaveTypeId       String             @map("leave_type_id")
  academicSessionId String             @map("academic_session_id")
  fromDate          DateTime           @map("from_date") @db.Date
  toDate            DateTime           @map("to_date") @db.Date
  halfDay           HalfDay?           @map("half_day")
  /// Working days in the range (weekly offs and staff holidays excluded), computed by the service.
  days              Decimal            @db.Decimal(4, 1)
  /// Personal tier — never written to audit rows.
  reason            String             @db.VarChar(500)
  status            LeaveRequestStatus @default(PENDING)
  requestedById     String?            @map("requested_by_id")
  decidedById       String?            @map("decided_by_id")
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(3)
  decisionNote      String?            @map("decision_note") @db.VarChar(500)
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType       LeaveType            @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  academicSession AcademicSession      @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  requestedBy     User?                @relation("LeaveRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy       User?                @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  attendance      EmployeeAttendance[]

  @@index([employeeId, fromDate])
  @@index([status, fromDate])
  @@map("leave_request")
}

/// One row per employee per day (L7). Approved leave, holidays and weekly offs are pre-filled by the service.
model EmployeeAttendance {
  id               String                @id @default(cuid(2))
  employeeId       String                @map("employee_id")
  date             DateTime              @db.Date
  status           StaffAttendanceStatus
  /// School-local times of day (optional).
  checkIn          DateTime?             @map("check_in") @db.Time(0)
  checkOut         DateTime?             @map("check_out") @db.Time(0)
  source           AttendanceSource      @default(MANUAL)
  leaveRequestId   String?               @map("leave_request_id")
  /// Required when a saved day is changed (L8) — personal tier, never in audit rows.
  correctionReason String?               @map("correction_reason") @db.VarChar(500)
  markedById       String?               @map("marked_by_id")
  version          Int                   @default(1)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)
  markedBy     User?         @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@index([leaveRequestId])
  @@map("employee_attendance")
}

/// School calendar (shared with the Phase 4 academic calendar). appliesTo STAFF/ALL affects staff working days.
model Holiday {
  id          String           @id @default(cuid(2))
  date        DateTime         @db.Date
  name        String           @db.VarChar(80)
  appliesTo   HolidayAppliesTo @default(ALL) @map("applies_to")
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([date, appliesTo])
  @@map("holiday")
}

/// L8: a locked month (first day of the month) can't have staff attendance changed. Recorded in 3B, set by payroll (3C).
model AttendancePeriodLock {
  id         String   @id @default(cuid(2))
  month      DateTime @unique @db.Date
  lockedById String?  @map("locked_by_id")
  lockedAt   DateTime @default(now()) @map("locked_at") @db.Timestamptz(3)

  lockedBy User? @relation("AttendancePeriodLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)

  @@map("attendance_period_lock")
}

// ───────────────────────────── Phase 3C — payroll (PHASE_3C_PLAN.md, P1–P16 approved 2026-11-19) ─────────────────────────────

enum SalaryComponentKind {
  EARNING
  DEDUCTION
}

enum SalaryCalc {
  FIXED
  PERCENT_OF_BASIC
}

enum EmployeeSalaryStatus {
  PROPOSED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PayrollRunStatus {
  DRAFT
  PREPARED
  APPROVED
  PAID
}

enum PayrollDayBasis {
  WORKING_DAYS
  CALENDAR_DAYS
}

enum PayrollAdjustmentKind {
  BONUS
  ARREARS
  OTHER_EARNING
  OTHER_DEDUCTION
}

enum SalaryPaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  UPI
}

/// P1/P2: school-defined earnings and deductions (no seeded or statutory components). Deactivated, never deleted once used.
model SalaryComponent {
  id        String              @id @default(cuid(2))
  code      String              @unique @db.VarChar(20)
  name      String              @db.VarChar(80)
  nameKey   String              @unique @map("name_key") @db.VarChar(80)
  kind      SalaryComponentKind
  calc      SalaryCalc
  /// Multiplied by paidDays / monthDays when true (P3, P15).
  prorated  Boolean             @default(true)
  isActive  Boolean             @default(true) @map("is_active")
  version   Int                 @default(1)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  items SalaryStructureItem[]

  @@map("salary_component")
}

/// A salary template (e.g. "Teaching - PGT"). Items are amounts (FIXED) or percentages of basic (PERCENT_OF_BASIC).
model SalaryStructure {
  id        String   @id @default(cuid(2))
  name      String   @db.VarChar(80)
  nameKey   String   @unique @map("name_key") @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items    SalaryStructureItem[]
  salaries EmployeeSalary[]

  @@map("salary_structure")
}

model SalaryStructureItem {
  id          String   @id @default(cuid(2))
  structureId String   @map("structure_id")
  componentId String   @map("component_id")
  /// Rupees (FIXED) or percent 0-100 (PERCENT_OF_BASIC; the service checks the range against the component).
  value       Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([structureId, componentId])
  @@index([componentId])
  @@map("salary_structure_item")
}

/// P7 maker-checker: HR proposes, a payroll.approve holder (not the proposer, not the subject) decides. Never edited
/// once decided: a change is a new row. One pending proposal per employee and one APPROVED row per (employee, month)
/// (partial unique indexes, raw SQL). The salary for a month is the APPROVED row with the latest effectiveFrom <= month.
model EmployeeSalary {
  id            String               @id @default(cuid(2))
  employeeId    String               @map("employee_id")
  structureId   String               @map("structure_id")
  basic         Decimal              @db.Decimal(12, 2)
  /// First day of the month from which this salary applies.
  effectiveFrom DateTime             @map("effective_from") @db.Date
  status        EmployeeSalaryStatus @default(PROPOSED)
  proposedById  String?              @map("proposed_by_id")
  decidedById   String?              @map("decided_by_id")
  decidedAt     DateTime?            @map("decided_at") @db.Timestamptz(3)
  /// Personal tier (shown to payroll readers), never in audit rows.
  decisionNote  String?              @map("decision_note") @db.VarChar(500)
  version       Int                  @default(1)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  structure  SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)
  proposedBy User?           @relation("SalaryProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  decidedBy  User?           @relation("SalaryDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  slips      PayrollSlip[]

  /// One pending proposal per employee; one approved salary per employee and month (partial unique indexes).
  @@unique([employeeId], map: "employee_salary_one_pending_key", where: raw("status = 'PROPOSED'"))
  @@unique([employeeId, effectiveFrom], map: "employee_salary_one_approved_per_month_key", where: raw("status = 'APPROVED'"))
  @@index([employeeId, effectiveFrom])
  @@index([structureId])
  @@map("employee_salary")
}

/// One run per month. DRAFT -> PREPARED (slips computed) -> APPROVED (slip numbers, attendance month locked: P5, P11)
/// -> PAID. Reopen (P16): APPROVED -> PREPARED before any payment, with a reason (audited, not stored here).
model PayrollRun {
  id              String           @id @default(cuid(2))
  /// First day of the payroll month.
  month           DateTime         @unique @db.Date
  status          PayrollRunStatus @default(DRAFT)
  /// Snapshot of SchoolSetting.payrollDayBasis when prepared (P3).
  dayBasis        PayrollDayBasis? @map("day_basis")
  employeeCount   Int              @default(0) @map("employee_count")
  totalGross      Decimal          @default(0) @map("total_gross") @db.Decimal(12, 2)
  totalDeductions Decimal          @default(0) @map("total_deductions") @db.Decimal(12, 2)
  totalNet        Decimal          @default(0) @map("total_net") @db.Decimal(12, 2)
  preparedById    String?          @map("prepared_by_id")
  preparedAt      DateTime?        @map("prepared_at") @db.Timestamptz(3)
  approvedById    String?          @map("approved_by_id")
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz(3)
  reopenCount     Int              @default(0) @map("reopen_count")
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  preparedBy User?         @relation("PayrollPreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  approvedBy User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  slips      PayrollSlip[]

  @@map("payroll_run")
}

/// One employee's slip in a run: a SNAPSHOT, later structure / salary edits never change it (skill, R6). Amounts in
/// rupees, 2 dp, half-up per component. slipNo comes from lib/sequence at approval (P11) and is kept on reopen.
model PayrollSlip {
  id               String          @id @default(cuid(2))
  runId            String          @map("run_id")
  employeeId       String          @map("employee_id")
  employeeSalaryId String          @map("employee_salary_id")
  slipNo           String?         @unique @map("slip_no") @db.VarChar(32)
  /// { structureName, basic, items: [{ code, name, kind, calc, value, prorated }] } as used for this slip.
  salarySnapshot   Json            @map("salary_snapshot")
  dayBasis         PayrollDayBasis @map("day_basis")
  monthDays        Int             @map("month_days")
  offRollsDays     Int             @map("off_rolls_days")
  lopDays          Decimal         @map("lop_days") @db.Decimal(5, 1)
  paidDays         Decimal         @map("paid_days") @db.Decimal(5, 1)
  /// [{ code, name, amount }]: computed components (adjustments are separate rows).
  earnings         Json
  deductions       Json
  gross            Decimal         @db.Decimal(12, 2)
  totalDeductions  Decimal         @map("total_deductions") @db.Decimal(12, 2)
  net              Decimal         @db.Decimal(12, 2)
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  run            PayrollRun          @relation(fields: [runId], references: [id], onDelete: Restrict)
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeSalary EmployeeSalary      @relation(fields: [employeeSalaryId], references: [id], onDelete: Restrict)
  adjustments    PayrollAdjustment[]
  payments       SalaryPayment[]

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([employeeSalaryId])
  @@map("payroll_slip")
}

/// P10: bonus, arrears and one-off items, only while the run is DRAFT / PREPARED. The note is personal tier.
model PayrollAdjustment {
  id          String                @id @default(cuid(2))
  slipId      String                @map("slip_id")
  kind        PayrollAdjustmentKind
  amount      Decimal               @db.Decimal(12, 2)
  note        String                @db.VarChar(500)
  createdById String?               @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  slip      PayrollSlip @relation(fields: [slipId], references: [id], onDelete: Restrict)
  createdBy User?       @relation("PayrollAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([slipId])
  @@map("payroll_adjustment")
}

/// P13: payments recorded per slip (a bulk payment writes one row per slip). The service keeps the sum <= the slip's net.
model SalaryPayment {
  id        String              @id @default(cuid(2))
  slipId    String              @map("slip_id")
  amount    Decimal             @db.Decimal(12, 2)
  method    SalaryPaymentMethod
  /// Bank / UPI / cheque reference; unique per method when present (partial unique index, raw SQL).
  reference String?             @db.VarChar(64)
  paidOn    DateTime            @map("paid_on") @db.Date
  paidById  String?             @map("paid_by_id")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  slip   PayrollSlip @relation(fields: [slipId], references: [id], onDelete: Restrict)
  paidBy User?       @relation("SalaryPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@unique([method, reference], map: "salary_payment_method_reference_key", where: raw("reference IS NOT NULL"))
  @@index([slipId])
  @@map("salary_payment")
}

// ───────────────────────────── Phase 4A — teaching structure & student attendance (PHASE_4_PLAN.md, AC1–AC20 approved 2026-11-19) ─────────────────────────────

enum SubjectKind {
  SCHOLASTIC
  CO_SCHOLASTIC
}

enum PeriodKind {
  TEACHING
  BREAK
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

/// AC2: school-defined subjects (names in any script). Deactivated, never deleted once used.
model Subject {
  id        String      @id @default(cuid(2))
  code      String      @unique @db.VarChar(20)
  name      String      @db.VarChar(80)
  nameKey   String      @unique @map("name_key") @db.VarChar(80)
  kind      SubjectKind @default(SCHOLASTIC)
  isActive  Boolean     @default(true) @map("is_active")
  version   Int         @default(1)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  classSubjects ClassSubject[]

  @@map("subject")
}

/// AC3: what a class studies in one academic session. Optional subjects are chosen per student (StudentSubject).
model ClassSubject {
  id                String   @id @default(cuid(2))
  academicSessionId String   @map("academic_session_id")
  classId           String   @map("class_id")
  subjectId         String   @map("subject_id")
  isOptional        Boolean  @default(false) @map("is_optional")
  sortOrder         Int      @default(0) @map("sort_order")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession     @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  class           SchoolClass         @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject         Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  studentChoices  StudentSubject[]
  allocations     TeacherAllocation[]
  timetableSlots  TimetableSlot[]
  examSubjects    ExamSubject[]

  // Phase 4C
  homework Homework[]

  @@unique([academicSessionId, classId, subjectId])
  /// Target of composite FKs: rows that point at a class subject must be in its session (DB-enforced).
  @@unique([id, academicSessionId], map: "class_subject_id_academic_session_id_key")
  @@index([classId])
  @@index([subjectId])
  @@map("class_subject")
}

/// AC3: a student's optional subjects. Same session as the enrollment and the class subject (composite FKs); the
/// class subject belongs to the enrollment's class (service, under the enrollment row lock).
model StudentSubject {
  id                String   @id @default(cuid(2))
  academicSessionId String   @map("academic_session_id")
  enrollmentId      String   @map("enrollment_id")
  classSubjectId    String   @map("class_subject_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession   @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  enrollment      StudentEnrollment @relation(fields: [enrollmentId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  classSubject    ClassSubject      @relation(fields: [classSubjectId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)

  @@unique([enrollmentId, classSubjectId])
  @@index([classSubjectId])
  @@map("student_subject")
}

/// AC4: who teaches a class subject in a section — an ACTIVE, TEACHING employee with a linked login (service). One
/// teacher per subject per section. The source of subject-level ASSIGNED scope (marks entry in 4B).
model TeacherAllocation {
  id                String   @id @default(cuid(2))
  academicSessionId String   @map("academic_session_id")
  sectionId         String   @map("section_id")
  classSubjectId    String   @map("class_subject_id")
  employeeId        String   @map("employee_id")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  section         Section         @relation(fields: [sectionId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  classSubject    ClassSubject    @relation(fields: [classSubjectId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([sectionId, classSubjectId])
  @@index([employeeId, academicSessionId])
  @@index([classSubjectId])
  @@map("teacher_allocation")
}

/// AC5: the school's bell schedule per weekday for one session (0 = Sunday … 6 = Saturday).
model Period {
  id                String     @id @default(cuid(2))
  academicSessionId String     @map("academic_session_id")
  dayOfWeek         Int        @map("day_of_week") @db.SmallInt
  number            Int        @db.SmallInt
  label             String?    @db.VarChar(40)
  kind              PeriodKind @default(TEACHING)
  /// School-local times of day.
  startTime         DateTime   @map("start_time") @db.Time(0)
  endTime           DateTime   @map("end_time") @db.Time(0)
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  slots           TimetableSlot[]

  @@unique([academicSessionId, dayOfWeek, number])
  @@unique([id, academicSessionId], map: "period_id_academic_session_id_key")
  @@map("period")
}

/// AC5: one subject per section per period; one section per teacher per period (both DB-enforced). The teacher must
/// hold the allocation and the period must be a TEACHING period (service).
model TimetableSlot {
  id                String   @id @default(cuid(2))
  academicSessionId String   @map("academic_session_id")
  sectionId         String   @map("section_id")
  periodId          String   @map("period_id")
  classSubjectId    String   @map("class_subject_id")
  employeeId        String?  @map("employee_id")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  section         Section         @relation(fields: [sectionId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  period          Period          @relation(fields: [periodId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  classSubject    ClassSubject    @relation(fields: [classSubjectId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  employee        Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([sectionId, periodId])
  /// No double-booking: a teacher is in one section per period (partial: slots without a teacher are ignored).
  @@unique([employeeId, periodId], map: "timetable_slot_teacher_period_key", where: raw("employee_id IS NOT NULL"))
  @@index([periodId])
  @@index([classSubjectId])
  @@map("timetable_slot")
}

/// AC6/AC7: daily student attendance by the class teacher. Session-scoped through the enrollment (composite FK).
/// Changing a saved day later needs academic.manage and a reason (personal tier — never in audit rows).
model StudentAttendance {
  id                String                  @id @default(cuid(2))
  academicSessionId String                  @map("academic_session_id")
  enrollmentId      String                  @map("enrollment_id")
  date              DateTime                @db.Date
  status            StudentAttendanceStatus
  correctionReason  String?                 @map("correction_reason") @db.VarChar(500)
  markedById        String?                 @map("marked_by_id")
  version           Int                     @default(1)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession   @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  enrollment      StudentEnrollment @relation(fields: [enrollmentId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  markedBy        User?             @relation("StudentAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, date])
  @@index([academicSessionId, date])
  @@map("student_attendance")
}

// ───────────────────────────── Phase 4B — examinations, marks, report cards (PHASE_4_PLAN.md AC8–AC15) ─────────────────────────────

enum ExaminationStatus {
  DRAFT
  SCHEDULED
  MARKS_ENTRY
  LOCKED
  PUBLISHED
}

enum MarksSheetStatus {
  OPEN
  SUBMITTED
  APPROVED
}

enum MarkStatus {
  PRESENT
  ABSENT
  EXEMPT
}

/// AC8: a school-defined grading scale (a "CBSE-style" template is offered, never created automatically).
model GradeScale {
  id        String   @id @default(cuid(2))
  name      String   @db.VarChar(80)
  nameKey   String   @unique @map("name_key") @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bands        GradeBand[]
  examinations Examination[]

  @@map("grade_scale")
}

/// A band runs from its minimum percent to the next band's minimum (gap-free by construction; grade-calc.ts).
model GradeBand {
  id         String   @id @default(cuid(2))
  scaleId    String   @map("scale_id")
  minPercent Decimal  @map("min_percent") @db.Decimal(5, 2)
  grade      String   @db.VarChar(5)
  gradePoint Decimal? @map("grade_point") @db.Decimal(4, 1)
  remark     String?  @db.VarChar(60)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  scale GradeScale @relation(fields: [scaleId], references: [id], onDelete: Restrict)

  @@unique([scaleId, minPercent])
  @@unique([scaleId, grade])
  @@map("grade_band")
}

/// AC9: each exam stands alone. DRAFT → SCHEDULED → MARKS_ENTRY → LOCKED → PUBLISHED (result.publish).
model Examination {
  id                String            @id @default(cuid(2))
  academicSessionId String            @map("academic_session_id")
  name              String            @db.VarChar(80)
  nameKey           String            @map("name_key") @db.VarChar(80)
  gradeScaleId      String            @map("grade_scale_id")
  status            ExaminationStatus @default(DRAFT)
  startDate         DateTime?         @map("start_date") @db.Date
  endDate           DateTime?         @map("end_date") @db.Date
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)
  publishedById     String?           @map("published_by_id")
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  gradeScale      GradeScale      @relation(fields: [gradeScaleId], references: [id], onDelete: Restrict)
  publishedBy     User?           @relation("ExaminationPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  subjects        ExamSubject[]
  reportCards     ReportCard[]

  @@unique([academicSessionId, nameKey])
  @@unique([id, academicSessionId], map: "examination_id_academic_session_id_key")
  @@map("examination")
}

/// One class subject in an exam: date and maximum marks per part (0 = not examined); optional pass percent.
model ExamSubject {
  id                String    @id @default(cuid(2))
  academicSessionId String    @map("academic_session_id")
  examinationId     String    @map("examination_id")
  classSubjectId    String    @map("class_subject_id")
  examDate          DateTime? @map("exam_date") @db.Date
  maxTheory         Int       @default(0) @map("max_theory") @db.SmallInt
  maxPractical      Int       @default(0) @map("max_practical") @db.SmallInt
  maxInternal       Int       @default(0) @map("max_internal") @db.SmallInt
  passPercent       Decimal?  @map("pass_percent") @db.Decimal(5, 2)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  examination     Examination     @relation(fields: [examinationId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  classSubject    ClassSubject    @relation(fields: [classSubjectId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  sheets          MarksSheet[]

  @@unique([examinationId, classSubjectId])
  @@unique([id, academicSessionId], map: "exam_subject_id_academic_session_id_key")
  @@index([classSubjectId])
  @@map("exam_subject")
}

/// AC13: marks of one exam subject for one section — the teacher enters and submits; marks.approve approves (locks).
model MarksSheet {
  id                String           @id @default(cuid(2))
  academicSessionId String           @map("academic_session_id")
  examSubjectId     String           @map("exam_subject_id")
  sectionId         String           @map("section_id")
  status            MarksSheetStatus @default(OPEN)
  submittedById     String?          @map("submitted_by_id")
  submittedAt       DateTime?        @map("submitted_at") @db.Timestamptz(3)
  approvedById      String?          @map("approved_by_id")
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz(3)
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession    @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  examSubject     ExamSubject        @relation(fields: [examSubjectId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  section         Section            @relation(fields: [sectionId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  submittedBy     User?              @relation("MarksSheetSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy      User?              @relation("MarksSheetApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  marks           ExaminationMarks[]

  @@unique([examSubjectId, sectionId])
  @@unique([id, academicSessionId], map: "marks_sheet_id_academic_session_id_key")
  @@index([sectionId])
  @@map("marks_sheet")
}

/// One student's marks on a sheet. AB counts 0; EX leaves the subject out (AC10). Whole or half marks.
model ExaminationMarks {
  id                String     @id @default(cuid(2))
  academicSessionId String     @map("academic_session_id")
  marksSheetId      String     @map("marks_sheet_id")
  enrollmentId      String     @map("enrollment_id")
  status            MarkStatus @default(PRESENT)
  theory            Decimal?   @db.Decimal(5, 1)
  practical         Decimal?   @db.Decimal(5, 1)
  internal          Decimal?   @db.Decimal(5, 1)
  /// Required when an APPROVED sheet is corrected (marks.approve) — personal tier, never in audit rows.
  correctionReason  String?    @map("correction_reason") @db.VarChar(500)
  enteredById       String?    @map("entered_by_id")
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession   @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  sheet           MarksSheet        @relation(fields: [marksSheetId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  enrollment      StudentEnrollment @relation(fields: [enrollmentId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  enteredBy       User?             @relation("MarksEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@unique([marksSheetId, enrollmentId])
  @@index([enrollmentId])
  @@map("examination_marks")
}

/// AC15: a published report card is a SNAPSHOT of marks, grades and attendance; a later scale edit never changes it.
model ReportCard {
  id                String   @id @default(cuid(2))
  academicSessionId String   @map("academic_session_id")
  examinationId     String   @map("examination_id")
  enrollmentId      String   @map("enrollment_id")
  snapshot          Json
  remark            String?  @db.VarChar(300)
  documentId        String?  @unique @map("document_id")
  publishedAt       DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession    @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  examination     Examination        @relation(fields: [examinationId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  enrollment      StudentEnrollment  @relation(fields: [enrollmentId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  document        GeneratedDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([examinationId, enrollmentId])
  @@index([enrollmentId])
  @@map("report_card")
}

// ───────────────────────────── Phase 4C: promotion, homework, academic calendar ─────────────────────────────

enum PromotionKind {
  PROMOTE
  DETAIN
  LEAVE
}

enum PromotionStatus {
  PROPOSED
  CONFIRMED
}

/// AC16: one decision per enrollment at session end. The class teacher (or a student.promote holder) proposes; a
/// student.promote holder confirms in bulk, which creates the next-session enrollment (PROMOTE / DETAIN) or records the
/// leaving (LEAVE, with the student's new status). The old enrollment only gets its end status and date (KI-080).
model PromotionDecision {
  id                String          @id @default(cuid(2))
  academicSessionId String          @map("academic_session_id")
  fromEnrollmentId  String          @map("from_enrollment_id")
  decision          PromotionKind
  /// PROMOTE / DETAIN: the class in the next session (DETAIN = the same class). Null for LEAVE.
  toClassId         String?         @map("to_class_id")
  /// LEAVE: TRANSFERRED / WITHDRAWN / GRADUATED. Null otherwise.
  leaveAs           StudentStatus?  @map("leave_as")
  status            PromotionStatus @default(PROPOSED)
  proposedById      String?         @map("proposed_by_id")
  proposedAt        DateTime        @default(now()) @map("proposed_at") @db.Timestamptz(3)
  confirmedById     String?         @map("confirmed_by_id")
  confirmedAt       DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  /// The enrollment created on confirmation (PROMOTE / DETAIN).
  toEnrollmentId    String?         @unique @map("to_enrollment_id")
  version           Int             @default(1)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession    @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  fromEnrollment  StudentEnrollment  @relation("PromotionFrom", fields: [fromEnrollmentId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  toEnrollment    StudentEnrollment? @relation("PromotionTo", fields: [toEnrollmentId], references: [id], onDelete: Restrict)
  toClass         SchoolClass?       @relation(fields: [toClassId], references: [id], onDelete: Restrict)
  proposedBy      User?              @relation("PromotionProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  confirmedBy     User?              @relation("PromotionConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  /// One decision per enrollment (the enrollment fixes the session, so this is unique per enrollment).
  @@unique([fromEnrollmentId, academicSessionId])
  @@index([academicSessionId, status])
  @@map("promotion_decision")
}

/// AC17: text homework for one subject of one section (no online submission; attachments later — KI-094).
model Homework {
  id                String    @id @default(cuid(2))
  academicSessionId String    @map("academic_session_id")
  sectionId         String    @map("section_id")
  classSubjectId    String    @map("class_subject_id")
  title             String    @db.VarChar(150)
  details           String    @db.VarChar(4000)
  assignedOn        DateTime  @map("assigned_on") @db.Date
  dueOn             DateTime  @map("due_on") @db.Date
  postedById        String?   @map("posted_by_id")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  section         Section         @relation(fields: [sectionId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  classSubject    ClassSubject    @relation(fields: [classSubjectId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  postedBy        User?           @relation("HomeworkPostedBy", fields: [postedById], references: [id], onDelete: SetNull)

  @@index([sectionId, dueOn])
  @@index([classSubjectId])
  @@map("homework")
}

/// AC18: a school-day event on the academic calendar (separate from public CMS events). Holidays and exam dates come
/// from their own tables.
model AcademicEvent {
  id                String   @id @default(cuid(2))
  academicSessionId String   @map("academic_session_id")
  title             String   @db.VarChar(120)
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  details           String?  @db.VarChar(1000)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)

  @@index([academicSessionId, startDate])
  @@map("academic_event")
}

// ───────────────────────────── Phase 5A — fees (PHASE_5_PLAN.md; migration 20261124000000) ─────────────────────────────
// Money Decimal(12,2) (rule 7). Every per-student row points at the enrollment by (student_id, academic_session_id) —
// unique on student_enrollment — so a row can't name a student and an enrollment that disagree. Partial unique
// indexes and CHECKs are hand-written in the migration (commented there).

enum FeeCategoryKind {
  REGULAR
  ONE_TIME
  TRANSPORT
  LATE_FEE
  OPENING_BALANCE
  OTHER
}

enum FeeAppliesTo {
  ALL
  NEW_ADMISSION
  EXISTING
}

enum FeeConcessionKind {
  CONCESSION
  SCHOLARSHIP
  DISCOUNT
  WAIVER
}

enum FeeCalc {
  PERCENT
  FIXED
}

enum StudentConcessionStatus {
  PROPOSED
  APPROVED
  REJECTED
  REVOKED
}

enum LateFeeCalc {
  FLAT
  PER_DAY
  PERCENT
}

enum FeeChargeSource {
  MANUAL
  TRANSPORT
}

enum FeeInvoiceKind {
  INSTALLMENT
  OPENING_BALANCE
}

enum FeeInvoiceStatus {
  ISSUED
  PARTIAL
  PAID
  WAIVED
  CANCELLED
}

enum FeeInvoiceItemKind {
  STRUCTURE
  CHARGE
  LATE_FEE
  OPENING_BALANCE
}

enum FeePaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum FeePaymentStatus {
  SUCCESS
  CANCELLED
}

/// FC2: school-defined fee heads (no seeded names or amounts). Deactivate, never delete.
model FeeCategory {
  id        String          @id @default(cuid(2))
  code      String          @unique @db.VarChar(20)
  name      String          @db.VarChar(80)
  nameKey   String          @unique @map("name_key") @db.VarChar(80)
  kind      FeeCategoryKind @default(REGULAR)
  appliesTo FeeAppliesTo    @default(ALL) @map("applies_to")
  isActive  Boolean         @default(true) @map("is_active")
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  structureItems FeeStructureItem[]
  concessions    FeeConcessionCategory[]
  charges        StudentFeeCharge[]
  invoiceItems   FeeInvoiceItem[]

  @@map("fee_category")
}

/// FC3: the school's own schedule per session (monthly, quarterly or terms).
model FeeInstallment {
  id                String   @id @default(cuid(2))
  academicSessionId String   @map("academic_session_id")
  name              String   @db.VarChar(60)
  nameKey           String   @map("name_key") @db.VarChar(60)
  dueOn             DateTime @map("due_on") @db.Date
  sortOrder         Int      @default(0) @map("sort_order")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession    @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  structureItems  FeeStructureItem[]
  charges         StudentFeeCharge[]
  invoices        FeeInvoice[]

  @@unique([academicSessionId, nameKey])
  @@unique([id, academicSessionId])
  @@index([academicSessionId, dueOn])
  @@map("fee_installment")
}

/// FC3 / FC5: amounts per class per session; at most one ACTIVE structure per (session, class) — partial unique in SQL.
/// Frozen once an invoice uses it (service); a change is a new structure.
model FeeStructure {
  id                String   @id @default(cuid(2))
  academicSessionId String   @map("academic_session_id")
  classId           String   @map("class_id")
  name              String   @db.VarChar(80)
  isActive          Boolean  @default(true) @map("is_active")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession    @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  class           SchoolClass        @relation(fields: [classId], references: [id], onDelete: Restrict)
  items           FeeStructureItem[]
  invoices        FeeInvoice[]

  @@unique([id, academicSessionId])
  /// Partial unique indexes (migration 20261124000000; declared for drift checks — partialIndexes preview).
  @@unique([academicSessionId, classId], map: "fee_structure_active_key", where: raw("is_active"))
  @@index([academicSessionId, classId])
  @@map("fee_structure")
}

model FeeStructureItem {
  id                String  @id @default(cuid(2))
  structureId       String  @map("structure_id")
  academicSessionId String  @map("academic_session_id")
  categoryId        String  @map("category_id")
  installmentId     String  @map("installment_id")
  amount            Decimal @db.Decimal(12, 2)

  structure   FeeStructure   @relation(fields: [structureId, academicSessionId], references: [id, academicSessionId], onDelete: Cascade)
  category    FeeCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installment FeeInstallment @relation(fields: [installmentId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)

  @@unique([structureId, categoryId, installmentId])
  @@index([installmentId])
  @@map("fee_structure_item")
}

/// FC6: a concession / scholarship template; applies to the listed categories.
model FeeConcession {
  id        String            @id @default(cuid(2))
  code      String            @unique @db.VarChar(20)
  name      String            @db.VarChar(80)
  nameKey   String            @unique @map("name_key") @db.VarChar(80)
  kind      FeeConcessionKind @default(CONCESSION)
  calc      FeeCalc
  /// Percent 0–100 (PERCENT) or rupees (FIXED, per invoice).
  value     Decimal           @db.Decimal(12, 2)
  isActive  Boolean           @default(true) @map("is_active")
  version   Int               @default(1)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories FeeConcessionCategory[]
  students   StudentConcession[]

  @@map("fee_concession")
}

model FeeConcessionCategory {
  concessionId String @map("concession_id")
  categoryId   String @map("category_id")

  concession FeeConcession @relation(fields: [concessionId], references: [id], onDelete: Cascade)
  category   FeeCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([concessionId, categoryId])
  @@index([categoryId])
  @@map("fee_concession_category")
}

/// FC6 maker-checker: proposed with fee.concession.manage, decided with fee.concession.approve (approver ≠ proposer).
/// At most one PROPOSED / APPROVED row per (enrollment, concession) — partial unique in SQL. The reason is
/// personal-tier text: shown to fee staff, never audited.
model StudentConcession {
  id                String                  @id @default(cuid(2))
  studentId         String                  @map("student_id")
  academicSessionId String                  @map("academic_session_id")
  concessionId      String                  @map("concession_id")
  status            StudentConcessionStatus @default(PROPOSED)
  reason            String                  @db.VarChar(500)
  proposedById      String?                 @map("proposed_by_id")
  proposedAt        DateTime                @default(now()) @map("proposed_at") @db.Timestamptz(3)
  decidedById       String?                 @map("decided_by_id")
  decidedAt         DateTime?               @map("decided_at") @db.Timestamptz(3)
  version           Int                     @default(1)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment StudentEnrollment @relation(fields: [studentId, academicSessionId], references: [studentId, academicSessionId], onDelete: Restrict)
  concession FeeConcession     @relation(fields: [concessionId], references: [id], onDelete: Restrict)
  proposedBy User?             @relation("ConcessionProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  decidedBy  User?             @relation("ConcessionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  /// Partial unique indexes (migration 20261124000000; declared for drift checks — partialIndexes preview).
  @@unique([studentId, academicSessionId, concessionId], map: "student_concession_live_key", where: raw("status = ANY (ARRAY['PROPOSED'::\"StudentConcessionStatus\", 'APPROVED'::\"StudentConcessionStatus\"])"))
  @@index([studentId, academicSessionId])
  @@index([status])
  @@map("student_concession")
}

/// FC7: at most one active rule per session (partial unique in SQL).
model LateFeeRule {
  id                String      @id @default(cuid(2))
  academicSessionId String      @map("academic_session_id")
  graceDays         Int         @map("grace_days")
  calc              LateFeeCalc
  value             Decimal     @db.Decimal(12, 2)
  cap               Decimal?    @db.Decimal(12, 2)
  isActive          Boolean     @default(true) @map("is_active")
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)

  /// Partial unique indexes (migration 20261124000000; declared for drift checks — partialIndexes preview).
  @@unique([academicSessionId], map: "late_fee_rule_active_key", where: raw("is_active"))
  @@index([academicSessionId])
  @@map("late_fee_rule")
}

/// FC18: per-student extras picked up by invoice generation — MANUAL (hostel, activity, cheque bounce) or TRANSPORT
/// (written by the Phase 7 transport service through a fees function). `invoiceItem` set once billed.
model StudentFeeCharge {
  id                String          @id @default(cuid(2))
  studentId         String          @map("student_id")
  academicSessionId String          @map("academic_session_id")
  installmentId     String          @map("installment_id")
  categoryId        String          @map("category_id")
  amount            Decimal         @db.Decimal(12, 2)
  source            FeeChargeSource @default(MANUAL)
  sourceRef         String?         @map("source_ref") @db.VarChar(64)
  note              String          @db.VarChar(200)
  createdById       String?         @map("created_by_id")
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)
  version           Int             @default(1)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment  StudentEnrollment @relation(fields: [studentId, academicSessionId], references: [studentId, academicSessionId], onDelete: Restrict)
  installment FeeInstallment    @relation(fields: [installmentId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  category    FeeCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation("FeeChargeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  invoiceItem FeeInvoiceItem?

  /// Partial unique indexes (migration 20261124000000; declared for drift checks — partialIndexes preview).
  @@unique([studentId, academicSessionId, installmentId, sourceRef], map: "student_fee_charge_live_source_key", where: raw("(source = 'TRANSPORT'::\"FeeChargeSource\") AND (deleted_at IS NULL)"))
  @@index([studentId, academicSessionId, installmentId])
  @@map("student_fee_charge")
}

/// FC4 / FC5: one live invoice per (student, session, installment) and one live opening-balance invoice per
/// (student, session) — partial uniques WHERE deleted_at IS NULL. Cancelling = status CANCELLED + deletedAt (only
/// without payments; service). Number from lib/sequence at issue.
model FeeInvoice {
  id                String           @id @default(cuid(2))
  invoiceNo         String           @unique @map("invoice_no") @db.VarChar(40)
  studentId         String           @map("student_id")
  academicSessionId String           @map("academic_session_id")
  kind              FeeInvoiceKind   @default(INSTALLMENT)
  installmentId     String?          @map("installment_id")
  /// KI-103 (migration 20261125000000): the fee structure an INSTALLMENT invoice was made from (null for opening
  /// balances). Freezes exactly that structure; CHECK kind INSTALLMENT ⇔ structure set.
  structureId       String?          @map("structure_id")
  /// Snapshot of the installment's due date at issue (an installment edit never moves issued invoices).
  dueOn             DateTime         @map("due_on") @db.Date
  subtotal          Decimal          @db.Decimal(12, 2)
  concessionTotal   Decimal          @default(0) @map("concession_total") @db.Decimal(12, 2)
  lateFee           Decimal          @default(0) @map("late_fee") @db.Decimal(12, 2)
  total             Decimal          @db.Decimal(12, 2)
  paidAmount        Decimal          @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status            FeeInvoiceStatus @default(ISSUED)
  issuedById        String?          @map("issued_by_id")
  issuedAt          DateTime         @default(now()) @map("issued_at") @db.Timestamptz(3)
  cancelledById     String?          @map("cancelled_by_id")
  cancelledAt       DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?          @map("cancel_reason") @db.VarChar(500)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment  StudentEnrollment      @relation(fields: [studentId, academicSessionId], references: [studentId, academicSessionId], onDelete: Restrict)
  installment FeeInstallment?        @relation(fields: [installmentId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  structure   FeeStructure?          @relation(fields: [structureId, academicSessionId], references: [id, academicSessionId], onDelete: Restrict)
  issuedBy    User?                  @relation("FeeInvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  cancelledBy User?                  @relation("FeeInvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items       FeeInvoiceItem[]
  allocations FeePaymentAllocation[]

  /// Review 5A M2: target of the allocation's (invoice, student) key.
  @@unique([id, studentId])
  /// Partial unique indexes (migration 20261124000000; declared for drift checks — partialIndexes preview).
  @@unique([studentId, academicSessionId, installmentId], map: "fee_invoice_live_installment_key", where: raw("(deleted_at IS NULL) AND (kind = 'INSTALLMENT'::\"FeeInvoiceKind\")"))
  @@unique([studentId, academicSessionId], map: "fee_invoice_live_opening_key", where: raw("(deleted_at IS NULL) AND (kind = 'OPENING_BALANCE'::\"FeeInvoiceKind\")"))
  @@index([studentId, status])
  @@index([academicSessionId, installmentId])
  @@index([structureId])
  @@index([status, dueOn])
  @@map("fee_invoice")
}

model FeeInvoiceItem {
  id               String             @id @default(cuid(2))
  invoiceId        String             @map("invoice_id")
  categoryId       String             @map("category_id")
  kind             FeeInvoiceItemKind
  /// Snapshot of the category name (later renames never change an issued invoice or receipt).
  description      String             @db.VarChar(120)
  amount           Decimal            @db.Decimal(12, 2)
  concessionAmount Decimal            @default(0) @map("concession_amount") @db.Decimal(12, 2)
  paidAmount       Decimal            @default(0) @map("paid_amount") @db.Decimal(12, 2)
  sortOrder        Int                @default(0) @map("sort_order")
  chargeId         String?            @unique @map("charge_id")

  invoice     FeeInvoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  category    FeeCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  charge      StudentFeeCharge?      @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  allocations FeePaymentAllocation[]

  /// Review 5A M2: target of the allocation's (item, invoice) key.
  @@unique([id, invoiceId])
  @@index([invoiceId])
  @@map("fee_invoice_item")
}

/// FC10–FC15: a payment IS its receipt (one row). Number from lib/sequence only on success; never reused; cancelled
/// receipts keep their number. U(idempotencyKey) stops double submits; a non-cash reference is unique per method
/// among SUCCESS payments (partial unique in SQL). The snapshot is what the receipt PDF prints.
model FeePayment {
  id              String           @id @default(cuid(2))
  receiptNo       String           @unique @map("receipt_no") @db.VarChar(40)
  studentId       String           @map("student_id")
  amount          Decimal          @db.Decimal(12, 2)
  method          FeePaymentMethod
  transactionRef  String?          @map("transaction_ref") @db.VarChar(40)
  instrumentDate  DateTime?        @map("instrument_date") @db.Date
  bankName        String?          @map("bank_name") @db.VarChar(80)
  paidOn          DateTime         @map("paid_on") @db.Date
  idempotencyKey  String           @unique @map("idempotency_key") @db.VarChar(64)
  collectedById   String?          @map("collected_by_id")
  receiptSnapshot Json             @map("receipt_snapshot")
  status          FeePaymentStatus @default(SUCCESS)
  cancelledById   String?          @map("cancelled_by_id")
  cancelledAt     DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?          @map("cancel_reason") @db.VarChar(500)
  printCount      Int              @default(0) @map("print_count")
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  collectedBy User?                  @relation("FeePaymentCollectedBy", fields: [collectedById], references: [id], onDelete: SetNull)
  cancelledBy User?                  @relation("FeePaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  allocations FeePaymentAllocation[]

  /// Review 5A M2: target of the allocation's (payment, student) key.
  @@unique([id, studentId])
  /// Partial unique indexes (migration 20261124000000; declared for drift checks — partialIndexes preview).
  @@unique([transactionRef], map: "fee_payment_live_utr_key", where: raw("(method = ANY (ARRAY['UPI'::\"FeePaymentMethod\", 'BANK_TRANSFER'::\"FeePaymentMethod\"])) AND (status = 'SUCCESS'::\"FeePaymentStatus\")"))
  @@unique([transactionRef, bankName, instrumentDate], map: "fee_payment_live_cheque_key", where: raw("(method = 'CHEQUE'::\"FeePaymentMethod\") AND (status = 'SUCCESS'::\"FeePaymentStatus\")"))
  @@unique([transactionRef], map: "fee_payment_live_card_key", where: raw("(method = 'CARD'::\"FeePaymentMethod\") AND (status = 'SUCCESS'::\"FeePaymentStatus\")"))
  @@index([studentId, paidOn])
  @@index([paidOn, method])
  @@index([collectedById, paidOn])
  @@map("fee_payment")
}

/// FC8: which invoice items a payment paid. Σ live allocations = payment amount (service + reconciliation report).
/// Cancelling a receipt sets reversedAt (rows are kept; a trigger allows nothing else).
/// Review 5A M2: composite keys tie the row together — the item belongs to the invoice, and the payment and the
/// invoice belong to the same student — so a receipt can never credit another student's invoice.
model FeePaymentAllocation {
  paymentId     String    @map("payment_id")
  invoiceItemId String    @map("invoice_item_id")
  invoiceId     String    @map("invoice_id")
  studentId     String    @map("student_id")
  amount        Decimal   @db.Decimal(12, 2)
  reversedAt    DateTime? @map("reversed_at") @db.Timestamptz(3)

  payment     FeePayment     @relation(fields: [paymentId, studentId], references: [id, studentId], onDelete: Restrict)
  invoiceItem FeeInvoiceItem @relation(fields: [invoiceItemId, invoiceId], references: [id, invoiceId], onDelete: Restrict)
  invoice     FeeInvoice     @relation(fields: [invoiceId, studentId], references: [id, studentId], onDelete: Restrict)

  @@id([paymentId, invoiceItemId])
  @@index([invoiceItemId])
  @@index([invoiceId])
  @@map("fee_payment_allocation")
}
