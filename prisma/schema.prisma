// Phase 1 schema: identity, RBAC, settings, sessions, sequences, files, audit,
// notifications, rate limiting and free-tier usage tracking.
// Domain models (students, fees, …) are added in later phases — see docs/DATABASE_SCHEMA.md.
// Connection URLs live in prisma.config.ts (Prisma 7), never here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & access ─────────────────────────────

enum PermissionScope {
  ALL
  ASSIGNED
  SELF
  CHILDREN
}

model User {
  id                 String    @id @default(cuid(2))
  username           String    @unique // stored lowercase
  email              String?   @unique // stored lowercase by the service layer; NULLs allowed
  displayName        String    @map("display_name")
  passwordHash       String    @map("password_hash")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  // Optional links to person records (added as FKs when those models land in Phases 3 & 6).
  employeeId         String?   @unique @map("employee_id")
  studentId          String?   @unique @map("student_id")
  guardianId         String?   @unique @map("guardian_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  roles         UserRole[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  notifications Notification[]
  uploadedFiles StoredFile[]

  @@index([isActive])
  @@map("user")
}

model Session {
  id         String   @id @default(cuid(2))
  tokenHash  String   @unique @map("token_hash") // SHA-256 of the cookie token; raw token never stored
  userId     String   @map("user_id")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent") @db.VarChar(400)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(cuid(2))
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

model Role {
  id          String   @id @default(cuid(2))
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id          String @id @default(cuid(2))
  key         String @unique
  module      String
  description String

  roles RolePermission[]

  @@index([module])
  @@map("permission")
}

model RolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  scope        PermissionScope @default(ALL)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// ───────────────────────────── Settings & core ─────────────────────────────

/// Singleton row (id = "default"). School-specific facts live here, never in code.
/// No secrets: API keys and passwords are environment variables only.
model SchoolSetting {
  id                       String   @id @default("default")
  name                     String
  shortCode                String   @map("short_code") @db.VarChar(10)
  affiliationNo            String?  @map("affiliation_no")
  board                    String?
  address                  Json?
  phones                   String[]
  email                    String?
  website                  String?
  logoFileId               String?  @map("logo_file_id")
  timezone                 String   @default("Asia/Kolkata")
  timings                  Json?
  branding                 Json?
  idFormats                Json?    @map("id_formats")
  rollNumberRules          Json?    @map("roll_number_rules")
  features                 Json? // toggles for optional external services (email, AI, payments)
  /// The single current academic session (a reference here guarantees there is at most one).
  currentAcademicSessionId String?  @unique @map("current_academic_session_id")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  currentAcademicSession AcademicSession? @relation(fields: [currentAcademicSessionId], references: [id], onDelete: Restrict)

  @@map("school_setting")
}

enum AcademicSessionStatus {
  PLANNED
  ACTIVE
  CLOSED
}

model AcademicSession {
  id        String                @id @default(cuid(2))
  name      String                @unique // e.g. "2026-27"
  startDate DateTime              @map("start_date") @db.Date
  endDate   DateTime              @map("end_date") @db.Date
  status    AcademicSessionStatus @default(PLANNED)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  currentFor SchoolSetting?

  @@map("academic_session")
}

/// Row-locked counters for human-facing serial numbers (see student-id-generation skill).
model SequenceCounter {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sequence_counter")
}

enum FileVisibility {
  PUBLIC // CMS media → Cloudinary (or other public CDN)
  PRIVATE // confidential documents → private storage, encrypted at rest by the app
}

model StoredFile {
  id           String         @id @default(cuid(2))
  visibility   FileVisibility
  provider     String // "local" | "s3" | "cloudinary"
  storageKey   String         @unique @map("storage_key")
  originalName String         @map("original_name") @db.VarChar(255)
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  sha256       String
  encrypted    Boolean        @default(false)
  keyVersion   Int?           @map("key_version")
  uploadedById String?        @map("uploaded_by_id")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([sha256])
  @@index([visibility])
  @@map("stored_file")
}

// ───────────────────────────── Audit & notifications ─────────────────────────────

/// Append-only. Polymorphic entity reference (no FK) so entries survive deletes.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id")
  actorLabel String?  @map("actor_label")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipHash     String?  @map("ip_hash")
  requestId  String?  @map("request_id")
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId, at])
  @@index([action, at])
  @@map("audit_log")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model Notification {
  id        String              @id @default(cuid(2))
  userId    String              @map("user_id")
  type      String
  title     String
  body      String
  link      String?
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notification")
}

// ───────────────────────────── Rate limiting & free-tier usage ─────────────────────────────

/// Fixed-window counters for the Postgres rate limiter (works across serverless instances).
model RateLimitBucket {
  key       String   @id // e.g. "login:ip:<hash>:<window>"
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_bucket")
}

/// Daily counters of metered external usage (emails, AI calls, uploads) so the app can
/// warn before and hard-stop at free-tier limits. See docs/FREE_TIER.md.
model UsageCounter {
  metric String // e.g. "email.sent", "ai.requests", "cloudinary.uploads"
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([metric, day])
  @@map("usage_counter")
}
