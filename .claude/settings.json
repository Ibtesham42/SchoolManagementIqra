{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx prisma format)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.preview)",
      "Read(./.env.e2e)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Edit(./.env.staging)",
      "Edit(./.env.preview)",
      "Edit(./.env.e2e)",
      "Bash(cat .env)",
      "Bash(cat .env.test)",
      "Bash(cat .env.local)",
      "Bash(cat .env.restore.local)",
      "Bash(type .env)",
      "Bash(type .env.test)",
      "Bash(more .env)",
      "Bash(more .env.test)",
      "Bash(head .env:*)",
      "Bash(head .env.test:*)",
      "Bash(tail .env:*)",
      "Bash(tail .env.test:*)",
      "Bash(Get-Content .env:*)",
      "Bash(Get-Content .env.test:*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push --force-reset:*)",
      "Bash(git push --force:*)"
    ]
  }
}
