# Copy to .env and fill in locally. Names only here; never commit real values.
# See docs/ENVIRONMENT_VARIABLES.md and docs/FREE_TIER.md

# Neon "development" branch. Pooled host contains "-pooler"; direct does not.
DATABASE_URL=
DIRECT_URL=
DB_POOL_MAX=5

# Neon "test" branch (pooled URL), used only by integration tests
TEST_DATABASE_URL=

APP_URL=http://localhost:3000
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1
DATA_HMAC_KEY=

# Private documents (encrypted by the app). Path must be outside the project's public/ folder.
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public website media only (logo, banners, gallery)
PUBLIC_MEDIA_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email: log = development preview, nothing is sent
EMAIL_PROVIDER=log
EMAIL_FROM=
RESEND_API_KEY=

# AI chatbot: none = FAQ + keyword search, no external calls
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_DAILY_REQUEST_LIMIT=0
EMBEDDING_PROVIDER=none

PAYMENT_GATEWAY=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RATE_LIMIT_DRIVER=postgres
CRON_SECRET=
LOG_LEVEL=info

# Seed only: first Super Admin (forced password change on first login)
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
