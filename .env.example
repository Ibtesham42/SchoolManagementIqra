# Copy to .env and fill in locally. Names only here; never commit real values.
# See docs/ENVIRONMENT_VARIABLES.md and docs/FREE_TIER.md

# Neon "development" branch. Pooled host contains "-pooler"; direct does not.
DATABASE_URL=
DIRECT_URL=
DB_POOL_MAX=5

# Production protection (ids are not secrets; both required by `npm run env:check`).
# Branch id(s) (br-...) refused after a read-only identity check; endpoint id(s) (ep-...) refused
# from the URL host name BEFORE any connection. `npm run setup:env` fills both in.
FORBIDDEN_BRANCH_IDS=
FORBIDDEN_ENDPOINT_IDS=
# Seed allow-list (ADR-032): `npm run db:seed` writes ONLY to this development branch/endpoint and
# refuses anything else. Not secrets. `npm run setup:env` fills both in.
SEED_TARGET_BRANCH_ID=
SEED_TARGET_ENDPOINT_ID=

# Neon "test" branch (pooled URL), used only by integration tests
TEST_DATABASE_URL=
# Integration-test allow-list (S-05; not secrets): `npm run test:integration` refuses to start unless
# TEST_DATABASE_URL and the live server are exactly this branch/endpoint (never development or production).
TEST_TARGET_BRANCH_ID=
TEST_TARGET_ENDPOINT_ID=
# e2e setup allow-list (S-06; not secrets): the branch/endpoint behind E2E_DATABASE_URL (a shell variable).
E2E_TARGET_BRANCH_ID=
E2E_TARGET_ENDPOINT_ID=

APP_URL=http://localhost:3000
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1
DATA_HMAC_KEY=
# Document verification codes only (never reuse another key). Rotation: move the current key to
# DOCUMENT_VERIFICATION_KEY_V<old version>=, set a new key and increment the version.
DOCUMENT_VERIFICATION_KEY=
DOCUMENT_VERIFICATION_KEY_VERSION=1

# Private documents (encrypted by the app). Path must be outside the project's public/ folder.
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public website media only (logo, banners, gallery)
PUBLIC_MEDIA_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email: log = development preview, nothing is sent
EMAIL_PROVIDER=log
EMAIL_FROM=
RESEND_API_KEY=

# AI chatbot: none = FAQ + keyword search, no external calls
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_DAILY_REQUEST_LIMIT=0
EMBEDDING_PROVIDER=none

PAYMENT_GATEWAY=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RATE_LIMIT_DRIVER=postgres
CRON_SECRET=
LOG_LEVEL=info

# Seed only: first Super Admin (forced password change on first login)
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
